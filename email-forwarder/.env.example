# ── Required ──────────────────────────────────────────────────────────────────
GMAIL_USER=miunifyldagroltd@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# ── Routing ───────────────────────────────────────────────────────────────────
FORWARD_TO=miunifyldagroltd@gmail.com
DOMAIN=miunifyldagroltd.com

# Comma-separated list — add new aliases here, no code change needed
ALIASES=info@miunifyldagroltd.com,md@miunifyldagroltd.com,chairman@miunifyldagroltd.com

# ── SMTP Server ───────────────────────────────────────────────────────────────
LISTEN_HOST=0.0.0.0
LISTEN_PORT=25

# ── Retry ─────────────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY=60

# ── Dedup ─────────────────────────────────────────────────────────────────────
DEDUP_WINDOW=300

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=forwarder.log
